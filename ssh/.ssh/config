Host hal* pi*
  SetEnv TERM=xterm-256color
  RequestTTY yes
  RemoteCommand command -v tmux >/dev/null && tmux new -A -s main || exec $SHELL

Host hal
  HostName hal.local
  User eigu47

Host pi
  HostName pi.local
  User eigu

Host hal.ts
  HostName hal
  User eigu47

Host pi.ts
  HostName pi
  User eigu

Host hal.cf
  HostName ssh.eiguchipablo.dev
  User eigu47
  ProxyCommand cloudflared access ssh --hostname %h

Host pi.cf
  HostName pi.eiguchipablo.dev
  User eigu
  ProxyCommand cloudflared access ssh --hostname %h
